# Copy to .env and fill in for local runs. Compose provides safe demo
# defaults for everything except the LLM key/model (required from phase 6:
# the query agent plans and synthesizes with a real LLM call).
JWT_SECRET=dev-demo-secret
LLM_PROVIDER=gemini
# e.g. gemini-2.5-flash
LLM_MODEL=
LLM_API_KEY=
# Optional endpoint override (defaults to the provider's public endpoint).
LLM_BASE_URL=
WDP_FAKE_TOKEN=dev-wdp-token
# ORCID(s) fake-wdp denies with 403 (distinct from absence). Must exist in
# rfff_seed AND have WDP records; seed_wdp.py verifies and picks this value
# deterministically when unset (it is the query3b demo anchor).
FAKE_WDP_DENY_ORCIDS=1031-4233-3498-2165
